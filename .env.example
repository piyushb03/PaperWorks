# PaperWorks Environment Configuration
# Copy this file to .env or .env.local and update values as needed

# Public Site URL (used for canonical URLs, sitemap, Open Graph metadata)
VITE_SITE_URL=https://paperworks.pro

# Direct Contact Channels
VITE_TELEGRAM_URL=https://t.me/yourusername
VITE_CONTACT_EMAIL=contact@paperworks.pro

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=
